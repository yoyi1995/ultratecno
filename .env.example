# Copy to .env.local. Empty values enable the local demo catalog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternatively use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Never put a service-role/secret key in NEXT_PUBLIC variables.
DEMO_MODE=false
# Local development defaults; demo login is always disabled on Netlify/Vercel.
DEMO_ADMIN_EMAIL=demo@ultratecno.local
DEMO_ADMIN_PASSWORD=UltraTecnoDemo2026!
# Set DEMO_MODE=true only to test next start on localhost without Supabase.
# Existing Cloudinary integration. Keep API credentials server-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
